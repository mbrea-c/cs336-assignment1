{
  description = "CS336 Assignment 1 environments managed with uv2nix";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";

    pyproject-nix = {
      url = "github:pyproject-nix/pyproject.nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };

    uv2nix = {
      url = "github:pyproject-nix/uv2nix";
      inputs.nixpkgs.follows = "nixpkgs";
      inputs.pyproject-nix.follows = "pyproject-nix";
    };

    pyproject-build-systems = {
      url = "github:pyproject-nix/build-system-pkgs";
      inputs.nixpkgs.follows = "nixpkgs";
      inputs.pyproject-nix.follows = "pyproject-nix";
      inputs.uv2nix.follows = "uv2nix";
    };
  };

  outputs =
    {
      self,
      nixpkgs,
      pyproject-nix,
      uv2nix,
      pyproject-build-systems,
      ...
    }:
    let
      inherit (nixpkgs) lib;

      # CUDA wheels support both Linux architectures. ROCm wheels are currently
      # published only for x86_64 Linux, while the CPU/MPS build covers macOS.
      supportedSystems = [
        "x86_64-linux"
        "aarch64-linux"
        "aarch64-darwin"
      ];

      forAllSystems = lib.genAttrs supportedSystems;

      backendsFor =
        system:
        [ "cpu" ]
        ++ lib.optional (lib.elem system [
          "x86_64-linux"
          "aarch64-linux"
        ]) "cuda"
        ++ lib.optional (system == "x86_64-linux") "rocm";

      defaultBackend = system: if system == "x86_64-linux" then "rocm" else "cpu";

      dependencySpec = backend: {
        cs336-basics = [ backend ];
      };

      # The PyTorch ROCm index does not publish a hash for its Triton wheel.
      # Keep uv.lock generated by uv and supply the missing fixed-output hash
      # at the uv2nix boundary.
      rocmWheelHashes = {
        "https://download-r2.pytorch.org/whl/triton_rocm-3.6.0-cp312-cp312-linux_x86_64.whl" =
          "sha256:cff15082784c7056b0af9347770e034ab0a8ccbce0642723ddc8c8de1bd6af3f";
      };

      uvLock =
        let
          lock = lib.importTOML ./uv.lock;
          addKnownHash =
            wheel:
            wheel
            // lib.optionalAttrs (builtins.hasAttr wheel.url rocmWheelHashes) {
              hash = rocmWheelHashes.${wheel.url};
            };
        in
        lock
        // {
          package = map (
            package:
            package
            // lib.optionalAttrs (package ? wheels) {
              wheels = map addKnownHash package.wheels;
            }
          ) lock.package;
        };

      workspace = uv2nix.lib.workspace.loadWorkspace {
        workspaceRoot = ./.;
        inherit uvLock;
      };

      editableOverlay = workspace.mkEditablePyprojectOverlay {
        root = "$REPO_ROOT";
      };

      mkPythonSet =
        system: backend:
        let
          pkgs = nixpkgs.legacyPackages.${system};

          workspaceOverlay = workspace.mkPyprojectOverlay {
            sourcePreference = "wheel";
            dependencies = dependencySpec backend;
          };

          pyprojectOverrides =
            final: prev:
            let
              addBuildInputs =
                package: extraBuildInputs:
                package.overrideAttrs (old: {
                  buildInputs = (old.buildInputs or [ ]) ++ extraBuildInputs;
                });

              addAutoPatchelfSearchPaths =
                package: searchPaths:
                package.overrideAttrs (old: {
                  preFixup =
                    (old.preFixup or "")
                    + lib.concatMapStrings (path: ''
                      addAutoPatchelfSearchPath ${lib.escapeShellArg path}
                    '') searchPaths;
                });

              nvidiaWheelLib =
                package: component: "${package}/lib/python3.12/site-packages/nvidia/${component}/lib";

              compressionLibraries = [
                pkgs.bzip2
                pkgs.xz
                pkgs.zlib
                pkgs.zstd
              ];

              commonOverrides = lib.optionalAttrs pkgs.stdenv.hostPlatform.isLinux {
                torch = addBuildInputs prev.torch compressionLibraries;
              };

              cudaOverrides = lib.optionalAttrs (backend == "cuda" && pkgs.stdenv.hostPlatform.isLinux) {
                # CUDA wheels cross-link to libraries in other wheels. Those
                # libraries live below site-packages rather than in $out/lib.
                nvidia-cudnn-cu13 = addAutoPatchelfSearchPaths prev.nvidia-cudnn-cu13 [
                  (nvidiaWheelLib final.nvidia-cublas "cu13")
                ];

                nvidia-cufft = addAutoPatchelfSearchPaths prev.nvidia-cufft [
                  (nvidiaWheelLib final.nvidia-nvjitlink "cu13")
                ];

                nvidia-cusolver = addAutoPatchelfSearchPaths prev.nvidia-cusolver [
                  (nvidiaWheelLib final.nvidia-cublas "cu13")
                  (nvidiaWheelLib final.nvidia-cusparse "cu13")
                  (nvidiaWheelLib final.nvidia-nvjitlink "cu13")
                ];

                nvidia-cusparse = addAutoPatchelfSearchPaths prev.nvidia-cusparse [
                  (nvidiaWheelLib final.nvidia-nvjitlink "cu13")
                ];

                nvidia-cufile = addBuildInputs prev.nvidia-cufile [
                  pkgs.rdma-core
                ];

                nvidia-nvshmem-cu13 = addBuildInputs prev.nvidia-nvshmem-cu13 [
                  pkgs.libfabric
                  pkgs.openmpi
                  pkgs.pmix
                  pkgs.rdma-core
                  pkgs.ucx
                ];

                torch =
                  (addAutoPatchelfSearchPaths (addBuildInputs prev.torch compressionLibraries) [
                    (nvidiaWheelLib final.nvidia-cublas "cu13")
                    (nvidiaWheelLib final.nvidia-cuda-cupti "cu13")
                    (nvidiaWheelLib final.nvidia-cuda-nvrtc "cu13")
                    (nvidiaWheelLib final.nvidia-cuda-runtime "cu13")
                    (nvidiaWheelLib final.nvidia-cudnn-cu13 "cudnn")
                    (nvidiaWheelLib final.nvidia-cufft "cu13")
                    (nvidiaWheelLib final.nvidia-cufile "cu13")
                    (nvidiaWheelLib final.nvidia-curand "cu13")
                    (nvidiaWheelLib final.nvidia-cusolver "cu13")
                    (nvidiaWheelLib final.nvidia-cusparse "cu13")
                    (nvidiaWheelLib final.nvidia-cusparselt-cu13 "cusparselt")
                    (nvidiaWheelLib final.nvidia-nccl-cu13 "nccl")
                    (nvidiaWheelLib final.nvidia-nvjitlink "cu13")
                    (nvidiaWheelLib final.nvidia-nvshmem-cu13 "nvshmem")
                    (nvidiaWheelLib final.nvidia-nvtx "cu13")
                  ]).overrideAttrs
                    (old: {
                      # libcuda is supplied by the host NVIDIA driver.
                      autoPatchelfIgnoreMissingDeps = (old.autoPatchelfIgnoreMissingDeps or [ ]) ++ [ "libcuda.so.1" ];
                    });

                triton = addBuildInputs prev.triton compressionLibraries;
              };

              rocmOverrides = lib.optionalAttrs (backend == "rocm") {
                torch = addBuildInputs prev.torch (
                  compressionLibraries
                  ++ [
                    pkgs.elfutils
                    pkgs.libdrm
                    pkgs.libffi
                    pkgs.ncurses
                    pkgs.numactl
                  ]
                );

                triton-rocm = addBuildInputs prev.triton-rocm compressionLibraries;
              };
            in
            commonOverrides // cudaOverrides // rocmOverrides;
        in
        (pkgs.callPackage pyproject-nix.build.packages {
          python = pkgs.python312;
        }).overrideScope
          (
            lib.composeManyExtensions [
              pyproject-build-systems.overlays.wheel
              workspaceOverlay
              pyprojectOverrides
            ]
          );

      pythonSets = forAllSystems (
        system: lib.genAttrs (backendsFor system) (backend: mkPythonSet system backend)
      );

      mkVirtualEnv =
        system: backend: editable:
        let
          basePythonSet = pythonSets.${system}.${backend};
          pythonSet = if editable then basePythonSet.overrideScope editableOverlay else basePythonSet;
          suffix = if editable then "dev-env" else "env";
        in
        pythonSet.mkVirtualEnv "cs336-basics-${backend}-${suffix}" (dependencySpec backend);

      mkDevShell =
        system: backend:
        let
          pkgs = nixpkgs.legacyPackages.${system};
          pythonSet = pythonSets.${system}.${backend};
          virtualenv = mkVirtualEnv system backend true;
        in
        pkgs.mkShell {
          packages = [
            virtualenv
            pkgs.git
            pkgs.py-spy
            pkgs.uv
          ];

          env = {
            CS336_TORCH_BACKEND = backend;
            UV_NO_SYNC = "1";
            UV_PYTHON = pythonSet.python.interpreter;
            UV_PYTHON_DOWNLOADS = "never";
          };

          shellHook = ''
            unset PYTHONPATH
            export REPO_ROOT="$(git rev-parse --show-toplevel)"
          ''
          + lib.optionalString (backend == "cuda") ''

            # NVIDIA's driver is mounted here on NixOS. CUDA wheels supply
            # userspace libraries, but libcuda itself is host-owned.
            if [ -d /run/opengl-driver/lib ]; then
              export LD_LIBRARY_PATH="/run/opengl-driver/lib''${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
            fi
          '';
        };
    in
    {
      packages = forAllSystems (
        system:
        let
          backendPackages = lib.genAttrs (backendsFor system) (backend: mkVirtualEnv system backend false);
        in
        backendPackages
        // {
          default = backendPackages.${defaultBackend system};
        }
      );

      devShells = forAllSystems (
        system:
        let
          backendShells = lib.genAttrs (backendsFor system) (backend: mkDevShell system backend);
        in
        backendShells
        // {
          default = backendShells.${defaultBackend system};
        }
      );

      checks = forAllSystems (
        system:
        let
          pkgs = nixpkgs.legacyPackages.${system};
          backend = defaultBackend system;
          virtualenv = self.packages.${system}.${backend};
        in
        {
          imports =
            pkgs.runCommand "cs336-basics-${backend}-imports"
              {
                nativeBuildInputs = [ virtualenv ];
              }
              ''
                python -c "import cs336_basics; import torch"
                touch "$out"
              '';
        }
      );
    };
}
